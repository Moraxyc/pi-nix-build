{
  "name": "pi-nix-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node${npm_package_engines_node#>=} --external:@earendil-works/* --external:typebox --outfile=dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27"
  }
}
